  "panels": [
    {"type":"stat","title":"API Availability","gridPos":{"h":4,"w":6,"x":0,"y":0},"targets":[{"expr":"avg(up{job=\"opspilot-api\"})","legendFormat":"availability"}],"fieldConfig":{"defaults":{"unit":"percentunit","min":0,"max":1},"overrides":[]}},
    {"type":"stat","title":"Windows CPU Utilization","gridPos":{"h":4,"w":6,"x":6,"y":0},"targets":[{"expr":"100 - (avg by (instance) (rate(windows_cpu_time_total{job=\"windows-exporter\",mode=\"idle\"}[5m])) * 100)","legendFormat":"CPU %"}],"fieldConfig":{"defaults":{"unit":"percent","min":0,"max":100},"overrides":[]}},
    {"type":"stat","title":"Windows Memory Utilization","gridPos":{"h":4,"w":6,"x":12,"y":0},"targets":[{"expr":"100 - (100 * windows_memory_physical_free_bytes{job=\"windows-exporter\"} / windows_memory_physical_total_bytes{job=\"windows-exporter\"})","legendFormat":"Memory %"}],"fieldConfig":{"defaults":{"unit":"percent","min":0,"max":100},"overrides":[]}},
    {"type":"timeseries","title":"API Request Rate","gridPos":{"h":8,"w":9,"x":18,"y":0},"targets":[{"expr":"sum(rate(http_requests_total{job=\"opspilot-api\"}[5m]))","legendFormat":"req/s"}],"fieldConfig":{"defaults":{},"overrides":[]}},
    {"type":"timeseries","title":"Windows CPU Utilization","gridPos":{"h":8,"w":9,"x":0,"y":8},"targets":[{"expr":"100 - (avg by (instance) (rate(windows_cpu_time_total{job=\"windows-exporter\",mode=\"idle\"}[5m])) * 100)","legendFormat":"{{instance}}"}],"fieldConfig":{"defaults":{"unit":"percent","min":0,"max":100},"overrides":[]}},
    {"type":"timeseries","title":"Windows Memory Utilization","gridPos":{"h":8,"w":9,"x":9,"y":8},"targets":[{"expr":"100 - (100 * windows_memory_physical_free_bytes{job=\"windows-exporter\"} / windows_memory_physical_total_bytes{job=\"windows-exporter\"})","legendFormat":"{{instance}}"}],"fieldConfig":{"defaults":{"unit":"percent","min":0,"max":100},"overrides":[]}},
    {"type":"timeseries","title":"Windows Disk Usage","gridPos":{"h":8,"w":9,"x":18,"y":8},"targets":[{"expr":"100 - 100 * (windows_logical_disk_free_bytes{job=\"windows-exporter\",volume=~\"[A-Z]:\"} / windows_logical_disk_size_bytes{job=\"windows-exporter\",volume=~\"[A-Z]:\"})","legendFormat":"{{volume}}"}],"fieldConfig":{"defaults":{"unit":"percent","min":0,"max":100},"overrides":[]}},
    {"type":"timeseries","title":"Windows Disk IO","gridPos":{"h":8,"w":9,"x":0,"y":16},"targets":[{"expr":"sum by (volume) (rate(windows_logical_disk_read_bytes_total{job=\"windows-exporter\",volume=~\"[A-Z]:\"}[5m]))","legendFormat":"{{volume}} read"},{"expr":"sum by (volume) (rate(windows_logical_disk_write_bytes_total{job=\"windows-exporter\",volume=~\"[A-Z]:\"}[5m]))","legendFormat":"{{volume}} write"}],"fieldConfig":{"defaults":{"unit":"Bps"},"overrides":[]}},
    {"type":"timeseries","title":"Container CPU","gridPos":{"h":8,"w":9,"x":9,"y":16},"targets":[{"expr":"100 * sum by (name) (rate(container_cpu_usage_seconds_total{name!=\"\"}[5m])) / clamp_min(machine_cpu_cores, 1)","legendFormat":"{{name}}"}],"fieldConfig":{"defaults":{"unit":"percent","min":0},"overrides":[]}},
    {"type":"timeseries","title":"Container Memory","gridPos":{"h":8,"w":6,"x":18,"y":16},"targets":[{"expr":"sum by (name) (container_memory_usage_bytes{name!=\"\"})","legendFormat":"{{name}}"}],"fieldConfig":{"defaults":{"unit":"bytes"},"overrides":[]}},
    {"type":"stat","title":"Docker Storage Used","gridPos":{"h":4,"w":6,"x":0,"y":24},"targets":[{"expr":"sum(container_fs_usage_bytes{name!=\"\"})","legendFormat":"used"}],"fieldConfig":{"defaults":{"unit":"bytes","decimals":1},"overrides":[]}},
    {"type":"timeseries","title":"PostgreSQL Connections","gridPos":{"h":8,"w":8,"x":6,"y":24},"targets":[{"expr":"sum(pg_stat_database_numbackends{job=\"postgres-exporter\"})","legendFormat":"connections"}],"fieldConfig":{"defaults":{},"overrides":[]}},
    {"type":"timeseries","title":"PostgreSQL Cache Hit Ratio","gridPos":{"h":8,"w":8,"x":14,"y":24},"targets":[{"expr":"sum(rate(pg_stat_database_blks_hit{job=\"postgres-exporter\"}[5m])) / clamp_min(sum(rate(pg_stat_database_blks_hit{job=\"postgres-exporter\"}[5m])) + sum(rate(pg_stat_database_blks_read{job=\"postgres-exporter\"}[5m])), 1)","legendFormat":"cache hit"}],"fieldConfig":{"defaults":{"unit":"percentunit","min":0,"max":1},"overrides":[]}},
    {"type":"timeseries","title":"PostgreSQL Transactions","gridPos":{"h":8,"w":8,"x":0,"y":32},"targets":[{"expr":"sum(rate(pg_stat_database_xact_commit{job=\"postgres-exporter\"}[5m]))","legendFormat":"commits/s"},{"expr":"sum(rate(pg_stat_database_xact_rollback{job=\"postgres-exporter\"}[5m]))","legendFormat":"rollbacks/s"}],"fieldConfig":{"defaults":{},"overrides":[]}}
